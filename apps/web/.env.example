# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor. Se usa para leer los datos que el motor necesita de la otra persona
# (meta y restricciones) al calcular una comida compartida, siempre después de
# verificar que quien pide el cálculo pertenece al hogar. Nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la app (para el enlace de inicio de sesión por correo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
